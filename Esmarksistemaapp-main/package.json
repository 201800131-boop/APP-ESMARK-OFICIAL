    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^41.3.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.7.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.4.0",
    "vite": "6.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "keepalive": "node keepAlive.js",
    "keepalive:cron": "node keepAlive.js --cron",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "node scripts/run-electron-dev.js",
    "build": "vite build",
    "tsc:electron": "npx tsc -p src/tsconfig.electron.json",
    "build:win": "npm run build && npm run tsc:electron && electron-builder --win --x64 --config src/electron-builder.json",
    "build:win:portable": "npm run build && npm run tsc:electron && electron-builder --win portable --config src/electron-builder.json",
    "build:all": "npm run build && npm run tsc:electron && electron-builder --win --x64 --ia32 --config src/electron-builder.json",
    "electron:build": "npm run build:win",
    "dist:win": "npm run build && npm run tsc:electron && electron-builder --win --publish always --config src/electron-builder.json",
    "supabase:start": "supabase start",
    "supabase:migrate-local": "node scripts/migrate-localstorage-to-supabase.mjs"
  }
